# ===== App =====
ENV=development
# Public base URL used for telephony webhooks (e.g. an ngrok HTTPS URL in dev).
SERVER_URL=https://your-ngrok-subdomain.ngrok-free.app

# ===== Database (Supabase Postgres) =====
# Configure EITHER DATABASE_URL (full URI) OR the DB_* parts below.
# Find these in the Supabase dashboard: Connect > Direct connection / pooler.
# Prefer the DB_* parts: the password is used as-is (no URL-encoding needed),
# so special characters like @ and # are fine. DATABASE_URL wins if non-empty.
DATABASE_URL=
DB_USER=postgres.<project-ref>
DB_PASSWORD="<your-db-password>"
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# ===== Auth =====
# Use a long, random secret in production.
JWT_SECRET=change-this-to-a-long-random-string

# ===== Redis (Celery broker / result backend) =====
REDIS_URL=redis://localhost:6379/0

# ===== MiniMax (LLM + TTS) =====
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
# International base by default; change for mainland-China accounts.
MINIMAX_API_BASE=https://api.minimax.io/v1

# ===== Speech-to-Text (ASR) =====
# MiniMax does NOT provide STT. Use an OpenAI-compatible transcription API
# (e.g. OpenAI Whisper). Leave STT_API_KEY empty to keep STT in mock mode.
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# ===== Vobiz (Indian calling) =====
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX
