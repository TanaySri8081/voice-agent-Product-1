# ===== App =====
ENV=development
# Public base URL used for telephony webhooks (e.g. an ngrok HTTPS URL in dev).
SERVER_URL=https://your-ngrok-subdomain.ngrok-free.app
# Comma-separated browser origins allowed to call the API (the dashboard).
# Set your deployed frontend URL here in production. Defaults cover local dev.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public dashboard URL. MUST match the origin you actually open the dashboard on,
# because password-reset / team-invite links are built from it — if it points at
# the wrong port, those emailed links open a dead page. Dev server runs on :3000
# (see frontend/package.json); set your real domain in production.
APP_BASE_URL=http://127.0.0.1:3000

# ===== Database (Supabase Postgres) =====
# Configure EITHER DATABASE_URL (full URI) OR the DB_* parts below.
# Find these in the Supabase dashboard: Connect > Direct connection / pooler.
# Prefer the DB_* parts: the password is used as-is (no URL-encoding needed),
# so special characters like @ and # are fine. DATABASE_URL wins if non-empty.
DATABASE_URL=
DB_USER=postgres.your_supabase_project_ref
DB_PASSWORD="your_db_password"
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# ===== Auth =====
# REQUIRED in production: a long, random secret (32+ chars). The app falls back
# to an insecure built-in default when this is empty, which would let anyone mint
# valid session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_secret
# Platform super-admins (comma-separated emails). These accounts can open the
# dashboard Admin page to assign plans / custom call allowances for any client.
# Set this to your own login email. Everyone else is denied (403).
SUPERADMIN_EMAILS=

# ===== Email (SMTP) =====
# For password reset + team invites. Leave SMTP_HOST empty in dev to log links
# to the server instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ===== Redis (Celery broker / result backend) =====
REDIS_URL=redis://localhost:6379/0

# ===== MiniMax (LLM + TTS) =====
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
# International base by default; change for mainland-China accounts.
MINIMAX_API_BASE=https://api.minimax.io/v1
# TTS language hint for correct pronunciation (Hindi / English / auto).
MINIMAX_LANGUAGE_BOOST=Hindi

# ===== Speech-to-Text (ASR) — Deepgram =====
# MiniMax has no STT. Create a key at https://console.deepgram.com/.
# Leave DEEPGRAM_API_KEY empty to keep STT in mock mode.
DEEPGRAM_API_KEY=
# nova-2 supports Hindi; language "hi" for Hindi-speaking callers.
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi

# ===== Vobiz (Indian calling) =====
# SIP trunk credentials (SIP connection / outbound). These are the SIP
# username/password from your Vobiz trunk — NOT the REST API keys below.
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=
# Vobiz REST API credentials — REQUIRED for one-click number provisioning
# (search + buy a DID and route it, from the dashboard). These are SEPARATE from
# the SIP username/password above. Get them from the Vobiz dashboard's API /
# Developer / Account section (an "Auth ID" and an "Auth Token").
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Vobiz inbound TRUNK id that points at your LiveKit SIP URI (e.g.
# <project>.sip.livekit.cloud). Vobiz does NOT auto-route new numbers: each DID
# must be assigned to a trunk via
#   PATCH /api/v1/Account/{auth_id}/numbers/{number}/assign  {"trunk_group_id": ...}
# One trunk serves ALL numbers, so this is a single one-time value that the
# provisioning flow reuses for every client's DID.
VOBIZ_TRUNK_GROUP_ID=

# ===== Call quota enforcement =====
# When true, inbound calls beyond a tenant's monthly allowance are answered with
# QUOTA_EXCEEDED_MESSAGE and ended. Default false (calls are never blocked), and
# the check is fail-open (any error while checking lets the call through).
ENFORCE_CALL_QUOTA=false
QUOTA_EXCEEDED_MESSAGE=Sorry, we are unable to take your call at the moment. Please try again later.

# ===== Payments (Razorpay) =====
# Self-serve plan upgrades via Razorpay Checkout. Leave blank to keep payments
# off — the dashboard then shows "Request upgrade" instead of a pay button.
# Use rzp_test_* keys while testing. KEY_ID is sent to the browser (public);
# KEY_SECRET and WEBHOOK_SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set this and add a webhook (URL: <SERVER_URL>/api/billing/webhook,
# event: payment.captured) in the Razorpay dashboard for reliable confirmation.
RAZORPAY_WEBHOOK_SECRET=

# ===== WhatsApp (Meta Cloud API) — appointment confirmations + reminders =====
# Official Meta WhatsApp Cloud API. These are the PLATFORM-LEVEL DEFAULTS / fallback:
# each client can set their OWN WhatsApp number + token + templates in the dashboard
# (Agent Setup > WhatsApp), which override these. Leave everything blank to keep
# WhatsApp off unless a tenant configures its own. Get platform values from
# Meta Business Manager > WhatsApp > API setup.
# Proactive messages must use PRE-APPROVED templates. Create two templates whose
# body has exactly three variables in this order:
#   {{1}} = customer name, {{2}} = business name, {{3}} = date/time
# e.g. "Hello {{1}}, your appointment at {{2}} is confirmed for {{3}}."
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Must match your approved templates' language code (e.g. en_US or hi).
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_CONFIRM_TEMPLATE=appointment_confirmation
WHATSAPP_REMINDER_TEMPLATE=appointment_reminder
# Send the reminder once the appointment is within this many minutes (120 = 2h).
WHATSAPP_REMINDER_LEAD_MIN=120
# How often the reminder worker polls for due reminders (seconds).
WHATSAPP_REMINDER_INTERVAL_SEC=300

# ===== LiveKit (voice agent SIP bridge) =====
# Used ONLY by the separate LiveKit voice agent (agent/main.py), NOT the FastAPI
# backend. Create a project at https://cloud.livekit.io and copy these from
# Project Settings > Keys. LIVEKIT_URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional overrides for the agent's behaviour (Hindi defaults are built in).
AGENT_SYSTEM_PROMPT=
AGENT_GREETING=
# REQUIRED for the agent to save bookings to the dashboard: a shared secret the
# agent sends to the backend's internal booking endpoint (POST /api/calls/agent-book).
# Use any long random string; the SAME value is read by both the backend and the
# agent from this .env. If empty, the agent cannot write bookings (endpoint 401).
AGENT_INTERNAL_SECRET=
# Where the agent reaches the FastAPI backend (default is fine for local runs).
AGENT_BACKEND_URL=http://127.0.0.1:8000
# Optional model/voice overrides for the agent:
#   MINIMAX_LLM_MODEL  - default MiniMax-Text-01 (non-reasoning, fast, no <think>).
#   MINIMAX_TTS_VOICE  - default Calm_Woman. Others: Wise_Woman, Friendly_Person,
#                        Patient_Man, Deep_Voice_Man.
#   MINIMAX_TTS_MODEL  - default speech-02-turbo.
MINIMAX_LLM_MODEL=
MINIMAX_TTS_VOICE=

# ===== Gemini (LLM — PREFERRED for the voice agent) =====
# Free/paid key from https://aistudio.google.com. The agent picks its LLM in this
# order: Gemini -> Groq -> MiniMax, so setting this wins.
# Why Gemini: Groq's free tier allows only ~12k tokens/min, and this agent sends
# ~3.3k per turn (prompt + tools + knowledge base), so it hit 429s and went SILENT
# mid-call after a few turns. Gemini's quota is far higher.
# Model note: use a "-latest" alias. Pinned ids like gemini-2.5-flash(-lite) return
# 404 for new keys, and gemini-flash-lite-latest was observed HANGING server-side
# (requests timing out), which also silences the agent. gemini-flash-latest is the
# reliable default (~1.3s to first token, correct tool-calling).
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest

# ===== Groq (LLM — fallback, used only when GEMINI_API_KEY is empty) =====
# Free API key at https://console.groq.com (starts with gsk_). TTS always stays
# MiniMax, so a cloned voice is unaffected by the LLM choice.
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ===== Voice agent tuning (all optional; sane defaults are in agent/main.py) =====
# TTS loudness. Applied AFTER synthesis via a soft-knee limiter, so speech gets
# louder while peaks stay clean (a plain multiply clipped and sounded "cut").
# Raise toward ~3.0 if callers say it's quiet; lower to ~1.5 if it sounds harsh.
MINIMAX_TTS_GAIN=2.0
MINIMAX_TTS_VOL=1.0
MINIMAX_TTS_SPEED=1.0
# Turn-taking. Lower = snappier replies, but too low makes the agent cut callers
# off mid-sentence. These were tuned against real call logs.
AGENT_MIN_ENDPOINTING=0.4
AGENT_MAX_ENDPOINTING=1.0
AGENT_VAD_MIN_SILENCE=0.4
# Hang up after this many seconds of caller silence.
AGENT_SILENCE_HANGUP_SEC=10
# Windows only: LiveKit's native layer can panic during call teardown, leaving the
# worker alive but unable to take the NEXT call. 1 = exit cleanly after each call
# so a supervisor/restart loop starts a fresh worker. Set 0 on Linux, where the
# panic doesn't occur and one warm worker serves many calls (lower latency).
AGENT_RECYCLE_AFTER_CALL=0
# Keep a job process pre-warmed so an incoming call isn't waiting for one to spawn.
AGENT_IDLE_PROCESSES=1
# Set 0 to halve per-turn token use (disables speculative generation) — only
# needed on a tight LLM quota.
AGENT_PREEMPTIVE=1
